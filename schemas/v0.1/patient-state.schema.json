{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medsystem1.invalid/v0.1/patient-state.schema.json",
  "type": "object",
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "encounter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "language": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "synthetic",
              "transcript",
              "note"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "source_id",
          "kind",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "enum": [
              "laterality",
              "symptom_duration",
              "photopsia",
              "floaters",
              "visual_acuity",
              "examination"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "assertion": {
            "enum": [
              "affirmed",
              "negated",
              "uncertain"
            ]
          },
          "temporality": {
            "enum": [
              "current",
              "historical",
              "unknown"
            ]
          },
          "subject": {
            "enum": [
              "patient",
              "other",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_id",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "field",
          "value",
          "assertion",
          "temporality",
          "subject",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "state_id",
    "revision",
    "encounter_id",
    "language",
    "sources",
    "facts"
  ],
  "additionalProperties": false
}
