{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medsystem1.invalid/v0.1/response.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "completed",
        "review_required",
        "abstained",
        "blocked"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "unknown"
      ]
    },
    "route": {
      "enum": [
        "rules",
        "local_auto",
        "frontier_fallback",
        "human_review",
        "abstain",
        "blocked"
      ]
    },
    "review_required": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "decision.schema.json"
      },
      "minItems": 1,
      "maxItems": 6
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "deterministic_match",
          "rule_missing_fields",
          "risk_requires_review",
          "urgency_review_only",
          "uncalibrated",
          "low_confidence",
          "capability_missing",
          "cloud_disabled",
          "privacy_not_cleared",
          "provider_timeout",
          "provider_error",
          "invalid_provider_output",
          "input_conflict",
          "input_truncated",
          "out_of_domain",
          "missing_evidence",
          "forbidden_scope",
          "calibration_mismatch",
          "fallback_used",
          "no_result",
          "validated_local_result",
          "observability_degraded"
        ]
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "versions": {
      "type": "object",
      "properties": {
        "software": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "calibration_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "software",
        "policy",
        "rules",
        "prompt",
        "provider",
        "model",
        "model_revision",
        "base_revision",
        "calibration_artifacts",
        "config_sha256"
      ],
      "additionalProperties": false
    },
    "timing_ms": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0
        },
        "local": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "frontier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "total",
        "local",
        "frontier"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "status",
    "risk",
    "route",
    "review_required",
    "results",
    "reason_codes",
    "versions",
    "timing_ms"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "risk": {
            "const": "low"
          },
          "route": {
            "enum": [
              "rules",
              "local_auto"
            ]
          },
          "review_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "enum": [
              "rules",
              "local_auto"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "enum": [
              "human_review",
              "frontier_fallback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "review_required"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "const": "abstain"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "abstained"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "abstained"
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "const": "abstain"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "review_required"
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "enum": [
              "human_review",
              "frontier_fallback"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "review_required"
          }
        }
      },
      "then": {
        "properties": {
          "review_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk": {
            "enum": [
              "moderate",
              "high",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "review_required": {
            "const": true
          },
          "status": {
            "enum": [
              "review_required",
              "blocked"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "review_required",
              "blocked"
            ]
          }
        }
      }
    }
  ]
}
